{% comment %}
  @author Benji Tigg
  @brief  General template file for MolSpin input.

# JSON Example for use of the template:

{
	"spinsystems": {
		"system1": {
			"spins": {
				"e1": {"spin": 1, "tensor": "isotropic(2)", "type": "electron"},
				"nuc": {"spin": 2, "tensor": "isotropic(1)", "type": "nucleus"}
			},
			"interactions": {
				"HF": {"type": "hyperfine", "group1": "e1", "group2": "nuc", "prefactor": 1e-3},
				"zeeman1": {"type": "zeeman", "spins": "e1", "field": "\"0 0 5e-5\""}
			},
			"states": {
				"SpinUp": {"spin(e1)": "|1/2>"},
				"SpinDown": {"spin(e1)": "-|1/2>"}
			},
			"transitions": {
				"DownReaction": {"source": "SpinDown", "rate": 1e-3}
			},
			"pulses": {
				"InstantPulse": {"type": "Instante Pulse", "angle": 90, "rotationaxis": "0 0 1", "group": "e1"}
			},
			"operators": {
				"Relaxation": {"type" = "relaxationt1", "rate" = 0.066, "spins" = "e1"}
			},
			"properties": {"initialstate": "SpinUp"}
		}
	},
	"settings": {"steps": 90},
	"actions": {
		"scan_field": {"type": "RotateVector", "vector": "system1.zeeman1.field", "axis": "\"0 1 0\"", "value": 1}
	},
	"outputs": {
		"orientation": {"type": "vectorangle", "vector": "system1.zeeman1.field", "reference": "\"0 0 1\""}
	},
	"tasks": {
		"do_calc": {"type": "StaticSS", "datafile": "\"results.dat\""}
	}
}

{% endcomment %}
// -------------------------------------------------------------
// MolSpin input file generated by MOLSPIN_PYTHON
// -------------------------------------------------------------
{% for system_name,system in spinsystems.items %}
SpinSystem {{ system_name }}
{
	{% if system.spins %}
	// ---------------------------------------------------------
	// Spins
	// ---------------------------------------------------------
    {% for sg_name,spingroup in system.spins.items %}
    {% for s_name,s in spingroup.items %}
	Spin {{ s_name }} 
	{
	    {% for key,value in s.items %}
		{{ key }} = {{ value|safe }};
        {% endfor %}
	}		
	{% endfor %}
    {% endfor %}
    {% endif %}
	{% if system.interactions %}
	// ---------------------------------------------------------
	// Interactions
	// ---------------------------------------------------------
    {% for i_name,i in system.interactions.items %}
	Interaction {{ i_name }}
	{
        {% for key,value in i.items %}
		{{ key }} = {{ value|safe }};
        {% endfor %}
	}
	{% endfor %}
    {% endif %}
	{% if system.states %}
	// ---------------------------------------------------------
	// Spin States
	// ---------------------------------------------------------
	{% for s_name, s in system.states.items %}
	State {{ s_name }}
	{
	    {% for key, value in s.items %}
	    {{ key|safe }} = {{ value|safe }};
	    {% endfor %}
	}
	{% endfor %}
	{% endif %}
	{% if system.transitions %}
	// ---------------------------------------------------------
	// Transitions
	// ---------------------------------------------------------
	{% for t_name, t in system.transitions.items %}
	Transition {{ t_name }}
	{
	    {% for key, value in t.items %}
	    {{ key }} = {{ value|safe }};
	    {% endfor %}
	}
	{% endfor %}
	{% endif %}
	{% if system.properties %}
	// ---------------------------------------------------------
	// SpinSystem Properties
	// ---------------------------------------------------------
	{% for p_name,p in system.properties.items %}
	Properties {{p_name}}
	{
        {% for key,value in p.items %}
		{{ key }} = {{ value|safe }};
        {% endfor %}
	}
	{% endfor %}

    {% endif %}
	{% if system.pulses %}
	// ---------------------------------------------------------
	// SpinSystem Pulses
	// ---------------------------------------------------------
    {% for p_name,p in system.pulses.items %}
	Pulse {{ p_name }}
	{
        {% for key,value in p.items %}
		{{ key }} = {{ value|safe }};
        {% endfor %}
	}
	{% endfor %}
    {% endif %}
	
	{% if system.pulsesequences %}
	{% for ps_name,ps in system.pulsesequences.items %}
	PulseSequence {{ ps_name }}
	{
		{% for key,value in ps.items %}
		{{ key }} = {{ value|safe }};
        {% endfor %}
	}
	{% endfor %}
    {% endif %}
	
	{% if system.operators %}
	// ---------------------------------------------------------
	// SpinSystem Operators
	// ---------------------------------------------------------
    {% for o_name,o in system.operators.items %}
	Operator {{ o_name }}
	{
        {% for key,value in o.items %}
		{{ key }} = {{ value|safe }};{% endfor %}
	}
	{% endfor %}
    {% endif %}
}
{% endfor %}
{% if settings or actions or outputs %}
Settings
{
    {% if settings %}
	// ---------------------------------------------------------
	// General settings
	// ---------------------------------------------------------
	{% for s_name,s in settings.items %}
	Settings {{s_name}}
	{
        {% for key,value in s.items %}
		{{ key }} = {{ value|safe }};
		{% endfor %}
	}
	{% endfor %}
	{% endif %}
    {% if actions %}
	// ---------------------------------------------------------
	// Actions
	// ---------------------------------------------------------
    {% for a_name,a in actions.items %}
	Action {{ a_name }}
	{
      {% for key,value in a.items %}
		{{ key }} = {{ value|safe }};
      {% endfor %}
	}
    {% endfor %}
	{% endif %}
    {% if outputs %}
	// ---------------------------------------------------------
	// Outputs
	// ---------------------------------------------------------
    {% for o_name,o in outputs.items %}
	Output {{ o_name }}
	{
        {% for key,value in o.items %}
		{{ key }} = {{ value|safe }};
        {% endfor %}
	}
    {% endfor %}
	{% endif %}
}
{% endif %}
{% if tasks %}
Run
{
    {% for t_name,t in tasks.items %}
	Task {{ t_name }}
	{
        {% for key,value in t.items %}
		{{ key }} = {{ value|safe }};
        {% endfor %}
	}
    {% endfor %}
}
{% endif %}